# Analysis engine production environment
SERVER_HOST=0.0.0.0
SERVER_PORT=8082
SERVER_WORKERS=10
SERVER_MAX_CONNECTIONS=4000
SERVER_REQUEST_TIMEOUT=300

DATABASE_URL=${DATABASE_URL}
DB_MAX_CONNECTIONS=120
DB_MIN_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=30
DB_ACQUIRE_TIMEOUT=30
DB_IDLE_TIMEOUT=600
DB_MAX_LIFETIME=3600
DB_ENABLE_MIGRATIONS=false

REDIS_URL=${REDIS_URL}
REDIS_MAX_CONNECTIONS=120
REDIS_CONNECTION_TIMEOUT=5
REDIS_RESPONSE_TIMEOUT=5
REDIS_ENABLE_CLUSTER=true

S3_ENDPOINT=${S3_ENDPOINT}
S3_REGION=${S3_REGION}
S3_BUCKET=${S3_BUCKET}
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
S3_USE_SSL=true
S3_PATH_STYLE=false
UPLOAD_DIR=/var/lib/nexus/uploads

ENABLE_YARA_ENGINE=true
YARA_RULES_DIR=/app/rules
ENABLE_FILE_SCANNER=true
ENABLE_URL_SCANNER=true
ENABLE_ARCHIVE_SCANNER=true
ENABLE_HASH_ANALYZER=true
ENABLE_ML_ANALYZER=true
ML_MODEL_PATH=/app/ml_models/model.onnx

ENABLE_SANDBOX=true
SANDBOX_BASE_IMAGE=ubuntu:22.04
SANDBOX_TIMEOUT=120
MAX_CONCURRENT_SANDBOXES=10
DOCKER_AVAILABLE=true

ENABLE_AUTHENTICATION=true
ENABLE_API_KEY_AUTH=true
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRY_HOURS=12
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=5000
CORS_ALLOWED_ORIGINS=https://app.nexus-security.com

LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_FILE_LOGGING=true
LOG_FILE_PATH=/var/log/nexus/analysis-engine.log
