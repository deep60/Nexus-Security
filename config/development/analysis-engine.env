# Analysis engine development environment
SERVER_HOST=0.0.0.0
SERVER_PORT=8082
SERVER_WORKERS=4
SERVER_MAX_CONNECTIONS=1000
SERVER_REQUEST_TIMEOUT=300

DATABASE_URL=postgresql://nexus_user:nexus_password@localhost:5432/nexus_security
DB_MAX_CONNECTIONS=50
DB_MIN_CONNECTIONS=5
DB_CONNECTION_TIMEOUT=30
DB_ACQUIRE_TIMEOUT=30
DB_IDLE_TIMEOUT=600
DB_MAX_LIFETIME=3600
DB_ENABLE_MIGRATIONS=true

REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECTION_TIMEOUT=5
REDIS_RESPONSE_TIMEOUT=5
REDIS_ENABLE_CLUSTER=false

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexus-submissions
S3_ACCESS_KEY=nexus_admin
S3_SECRET_KEY=nexus_secret_key_2024
S3_USE_SSL=false
S3_PATH_STYLE=true
UPLOAD_DIR=./uploads

ENABLE_YARA_ENGINE=true
YARA_RULES_DIR=./rules
ENABLE_FILE_SCANNER=true
ENABLE_URL_SCANNER=true
ENABLE_ARCHIVE_SCANNER=true
ENABLE_HASH_ANALYZER=true
ENABLE_ML_ANALYZER=false
ML_MODEL_PATH=./ml_models/model.onnx

ENABLE_SANDBOX=true
SANDBOX_BASE_IMAGE=ubuntu:22.04
SANDBOX_TIMEOUT=120
MAX_CONCURRENT_SANDBOXES=3
DOCKER_AVAILABLE=true

ENABLE_AUTHENTICATION=true
ENABLE_API_KEY_AUTH=false
JWT_SECRET=change-me-in-development
JWT_EXPIRY_HOURS=24
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

LOG_LEVEL=info
LOG_FORMAT=pretty
ENABLE_FILE_LOGGING=false
LOG_FILE_PATH=logs/analysis-engine.log
