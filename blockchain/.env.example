# Blockchain Deployment Configuration

# Network Configuration
NETWORK=sepolia
# hardhat.config.ts reads SEPOLIA_RPC first, then RPC_URL as a fallback.
SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
CHAIN_ID=11155111

# Wallet Configuration (DO NOT COMMIT REAL KEYS)
# hardhat.config.ts reads PRIVATE_KEY first, then DEPLOYER_PRIVATE_KEY.
# Must be a funded Sepolia account (needs >= 0.1 test ETH from a faucet).
PRIVATE_KEY=your_64_hex_char_private_key_here
DEPLOYER_PRIVATE_KEY=your_64_hex_char_private_key_here
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# Etherscan API Key (for contract verification)
# hardhat.config.ts reads ETHERSCAN_API first, then ETHERSCAN_API_KEY.
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Gas Configuration
GAS_PRICE=20000000000
GAS_LIMIT=5000000

# Contract Parameters
INITIAL_REPUTATION_SCORE=50
MIN_STAKE_AMOUNT=10000000000000000
REWARD_MULTIPLIER=150
PENALTY_MULTIPLIER=50

# Testing
TEST_MNEMONIC="test test test test test test test test test test test junk"
