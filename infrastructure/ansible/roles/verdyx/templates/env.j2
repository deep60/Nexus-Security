{# Rendered into /opt/verdyx/.env on the production host. Mode 0600. #}
NODE_ENV=production
ENVIRONMENT=production
PORT=5000
FRONTEND_URL=https://{{ verdyx_domain }}
API_URL=https://api.{{ verdyx_domain }}

POSTGRES_USER=verdyx_prod
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB=verdyx
DATABASE_URL=postgresql://verdyx_prod:{{ vault_postgres_password }}@postgres:5432/verdyx?sslmode=require

REDIS_PASSWORD={{ vault_redis_password }}
REDIS_URL=redis://:{{ vault_redis_password }}@redis:6379

JWT_SECRET={{ vault_jwt_secret }}
JWT_EXPIRY_HOURS=12
BCRYPT_SALT_ROUNDS=12
CORS_ALLOWED_ORIGINS=https://{{ verdyx_domain }}

MINIO_ROOT_USER={{ vault_minio_root_user | default('verdyx_admin') }}
MINIO_ROOT_PASSWORD={{ vault_minio_root_password }}
AWS_ACCESS_KEY_ID={{ vault_minio_root_user | default('verdyx_admin') }}
AWS_SECRET_ACCESS_KEY={{ vault_minio_root_password }}
AWS_REGION=us-east-1
AWS_S3_BUCKET=verdyx-prod-uploads

CHAIN_ID={{ blockchain_chain_id | default(1) }}
BLOCKCHAIN_RPC_URL={{ vault_blockchain_rpc_url }}
ETH_PROVIDER_URL={{ vault_blockchain_rpc_url }}
THREAT_TOKEN_ADDRESS={{ threat_token_address }}
REPUTATION_SYSTEM_ADDRESS={{ reputation_system_address }}
BOUNTY_MANAGER_ADDRESS={{ bounty_manager_address }}
TREASURY_ADDRESS={{ treasury_address }}
TREASURY_PRIVATE_KEY={{ vault_treasury_private_key }}

SMTP_HOST={{ smtp_host | default('email-smtp.us-east-1.amazonaws.com') }}
SMTP_PORT=587
SMTP_USER={{ vault_smtp_user | default('') }}
SMTP_USERNAME={{ vault_smtp_user | default('') }}
SMTP_PASSWORD={{ vault_smtp_password | default('') }}
EMAIL_FROM=noreply@{{ verdyx_domain }}

WEBHOOK_SIGNING_SECRET={{ vault_webhook_signing_secret }}
LOG_LEVEL=info
RUST_LOG=info

ENABLE_BLOCKCHAIN=true
ENABLE_IPFS=false
ENABLE_EMAIL=true
ENABLE_CLAMAV=true
